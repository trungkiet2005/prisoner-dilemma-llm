\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {How closely play follows the canonical memory-one rules, against the payoff scale.} Both panels are computed by exact matching, with no learned component. (a) Share of agent-games matched exactly by one canonical rule, one line per model, annotated with that model's trend per decade of $\lambda $; all five trends are negative, and only in GPT-5.4 Nano is the trend not distinguishable from zero (table~\ref {tab:strategy}). The shaded band marks the two scales at which every payoff printed is at most 1. (b) Mean number of rounds, out of the ten played, violating the nearest canonical rule. Here the trends do not all have the same sign: Grok 4.20 runs against the other four (table~\ref {tab:strategy}).}}{11}{figure.6}\protected@file@percent }
\newlabel{fig:ruleforce}{{6}{11}{\textbf {How closely play follows the canonical memory-one rules, against the payoff scale.} Both panels are computed by exact matching, with no learned component. (a) Share of agent-games matched exactly by one canonical rule, one line per model, annotated with that model's trend per decade of $\lam $; all five trends are negative, and only in GPT-5.4 Nano is the trend not distinguishable from zero (table~\ref {tab:strategy}). The shaded band marks the two scales at which every payoff printed is at most 1. (b) Mean number of rounds, out of the ten played, violating the nearest canonical rule. Here the trends do not all have the same sign: Grok 4.20 runs against the other four (table~\ref {tab:strategy})}{figure.6}{}}
\newlabel{fig:ruleforce@cref}{{[figure][6][]6}{[1][10][]11}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Share of agent-games carrying each canonical label, against the payoff scale.} One panel per canonical rule: (a) AllC, (b) Tit-for-Tat, (c) Win-Stay--Lose-Shift, (d) AllD. Each point is the share of that model's 400 agent-games at that scale carrying the label, and shaded bands mark the two scales at which every payoff printed is at most 1. The AllC and AllD panels rest partly on exact rule matching, whereas over the corpus $94.6\%$ of the Tit-for-Tat labels and $97.1\%$ of the Win-Stay--Lose-Shift labels are attributions made where no canonical rule fits, so those two panels should be read as a resemblance rather than as an identification.}}{11}{figure.7}\protected@file@percent }
\newlabel{fig:mix}{{7}{11}{\textbf {Share of agent-games carrying each canonical label, against the payoff scale.} One panel per canonical rule: (a) AllC, (b) Tit-for-Tat, (c) Win-Stay--Lose-Shift, (d) AllD. Each point is the share of that model's 400 agent-games at that scale carrying the label, and shaded bands mark the two scales at which every payoff printed is at most 1. The AllC and AllD panels rest partly on exact rule matching, whereas over the corpus $94.6\%$ of the Tit-for-Tat labels and $97.1\%$ of the Win-Stay--Lose-Shift labels are attributions made where no canonical rule fits, so those two panels should be read as a resemblance rather than as an identification}{figure.7}{}}
\newlabel{fig:mix@cref}{{[figure][7][]7}{[1][10][]11}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Cooperation on the opening move, against the payoff scale.} At round 1 the agent has seen only the matrix and the instructions. (a) Cooperation on the opening move, one curve per model. (b) Range of cooperation across the ten scales, on the opening move (solid) and over rounds 2 to 10 (hatched).}}{12}{figure.8}\protected@file@percent }
\newlabel{fig:firstmove}{{8}{12}{\textbf {Cooperation on the opening move, against the payoff scale.} At round 1 the agent has seen only the matrix and the instructions. (a) Cooperation on the opening move, one curve per model. (b) Range of cooperation across the ten scales, on the opening move (solid) and over rounds 2 to 10 (hatched)}{figure.8}{}}
\newlabel{fig:firstmove@cref}{{[figure][8][]8}{[1][10][]12}}
