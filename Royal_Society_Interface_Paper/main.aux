\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Cooperation over the ten payoff scales, by model.} Minimum, maximum and range, with a 95\% confidence interval on the range from a bootstrap over whole dyads and a permutation test on the payoff-scale label ($0.0005$ is the floor of 2{,}000 draws). The last two columns test the nine scale contrasts jointly in a per-model logistic regression of the round-level decision, clustered on the dyad. Each entry pools 200 dyads per scale; ranges are computed before rounding. Full specification in the electronic supplementary material.}}{6}{table.1}\protected@file@percent }
\newlabel{tab:effect}{{1}{6}{\textbf {Cooperation over the ten payoff scales, by model.} Minimum, maximum and range, with a 95\% confidence interval on the range from a bootstrap over whole dyads and a permutation test on the payoff-scale label ($0.0005$ is the floor of 2{,}000 draws). The last two columns test the nine scale contrasts jointly in a per-model logistic regression of the round-level decision, clustered on the dyad. Each entry pools 200 dyads per scale; ranges are computed before rounding. Full specification in the electronic supplementary material}{table.1}{}}
\newlabel{tab:effect@cref}{{[table][1][]1}{[1][6][]6}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Cooperation against the payoff scale in five language models.} (a) The same prisoner's dilemma at three payoff scales, shown to the agent as penalties to be minimised. (b) Cooperation against the payoff scale, one curve per model; the shaded band marks the two scales at which every payoff printed is at most 1. (c) The curves of (b) centred within model, with their average in black. Each point in (b) and (c) averages 200 dyads; the envelope around each curve in (b) is a 95\% percentile interval from 1{,}500 bootstrap resamples of whole dyads.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:scaling}{{1}{6}{\textbf {Cooperation against the payoff scale in five language models.} (a) The same prisoner's dilemma at three payoff scales, shown to the agent as penalties to be minimised. (b) Cooperation against the payoff scale, one curve per model; the shaded band marks the two scales at which every payoff printed is at most 1. (c) The curves of (b) centred within model, with their average in black. Each point in (b) and (c) averages 200 dyads; the envelope around each curve in (b) is a 95\% percentile interval from 1{,}500 bootstrap resamples of whole dyads}{figure.1}{}}
\newlabel{fig:scaling@cref}{{[figure][1][]1}{[1][6][]6}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}The size of the effect depends on the prompt language}{6}{subsection.3.2}\protected@file@percent }
\newlabel{sec:language}{{3.2}{6}{The size of the effect depends on the prompt language}{subsection.3.2}{}}
\newlabel{sec:language@cref}{{[subsection][2][3]3.2}{[1][6][]6}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {The departure from invariance, tested three ways.} (a) Across-scale range of cooperation per model, with a 95\% interval from the dyad bootstrap and the $p$ value of a permutation test that shuffles the payoff scale among whole dyads; $0.0005$ is the smallest value 2{,}000 draws can return. (b) Largest absolute log-odds contrast against $\lambda = 1$ in a per-model logistic regression of the round-level decision, with the clustered Wald statistic on its nine scale contrasts. (c) Correlation between the ten-point curve shapes of each pair of models, after centring each curve within model. Six of the ten pairs are negative.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:inference}{{2}{7}{\textbf {The departure from invariance, tested three ways.} (a) Across-scale range of cooperation per model, with a 95\% interval from the dyad bootstrap and the $p$ value of a permutation test that shuffles the payoff scale among whole dyads; $0.0005$ is the smallest value 2{,}000 draws can return. (b) Largest absolute log-odds contrast against $\lam = 1$ in a per-model logistic regression of the round-level decision, with the clustered Wald statistic on its nine scale contrasts. (c) Correlation between the ten-point curve shapes of each pair of models, after centring each curve within model. Six of the ten pairs are negative}{figure.2}{}}
\newlabel{fig:inference@cref}{{[figure][2][]2}{[1][6][]7}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Persona effect below and above the sub-unit boundary, by model.} Cooperation under a cooperative persona minus cooperation under a selfish one, at the two scales where every printed payoff is at most 1 ($\lambda \leq 0.1$) and at the eight where some payoff exceeds it. Intervals are 95\% confidence intervals from the dyad bootstrap. A sign flip needs both regime intervals to exclude zero on opposite sides, so a supra-unit interval straddling zero means the effect is abolished rather than reversed.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:persona}{{2}{7}{\textbf {Persona effect below and above the sub-unit boundary, by model.} Cooperation under a cooperative persona minus cooperation under a selfish one, at the two scales where every printed payoff is at most 1 ($\lam \leq 0.1$) and at the eight where some payoff exceeds it. Intervals are 95\% confidence intervals from the dyad bootstrap. A sign flip needs both regime intervals to exclude zero on opposite sides, so a supra-unit interval straddling zero means the effect is abolished rather than reversed}{table.2}{}}
\newlabel{tab:persona@cref}{{[table][2][]2}{[1][6][]7}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Rule agreement and rule distance against the payoff scale, by model.} Left, the share of agent-games matched exactly by one canonical rule, below and above the sub-unit boundary, with the coefficient of a logistic regression of that indicator on $\log _{10}\lambda $; right, the mean number of rounds violating the nearest canonical rule at the smallest and largest scale, with the same trend by least squares. Both $\beta $ are per decade of $\lambda $ and their signs differ between models. Both cluster on the dyad, and neither block uses the learned classifier.}}{7}{table.3}\protected@file@percent }
\newlabel{tab:strategy}{{3}{7}{\textbf {Rule agreement and rule distance against the payoff scale, by model.} Left, the share of agent-games matched exactly by one canonical rule, below and above the sub-unit boundary, with the coefficient of a logistic regression of that indicator on $\log _{10}\lam $; right, the mean number of rounds violating the nearest canonical rule at the smallest and largest scale, with the same trend by least squares. Both $\beta $ are per decade of $\lam $ and their signs differ between models. Both cluster on the dyad, and neither block uses the learned classifier}{table.3}{}}
\newlabel{tab:strategy@cref}{{[table][3][]3}{[1][6][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Cooperation against the payoff scale, by model and prompt language.} One panel per model, one curve per prompt language; the annotation gives the smallest and largest across-scale range among that model's five languages. Each point averages 40 dyads.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:language}{{3}{8}{\textbf {Cooperation against the payoff scale, by model and prompt language.} One panel per model, one curve per prompt language; the annotation gives the smallest and largest across-scale range among that model's five languages. Each point averages 40 dyads}{figure.3}{}}
\newlabel{fig:language@cref}{{[figure][3][]3}{[1][8][]8}}
