\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}Comparing EGT predictions and LLM-derived strategies}{12}{subsection.3.5}\protected@file@percent }
\newlabel{sec:egt_vs_llm}{{3.5}{12}{Comparing EGT predictions and LLM-derived strategies}{subsection.3.5}{}}
\newlabel{sec:egt_vs_llm@cref}{{[subsection][5][3]3.5}{[1][12][]12}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {EGT stationary distribution (blue) vs.\ LLM empirical distribution (red) at $\lambda \in \{0.1, 1, 10\}$.} EGT computed analytically under the small-mutation limit with the FAIRGAME penalty matrix scaled by $\lambda $, $r{=}10$ rounds, $\varepsilon {=}0.05$ implementation noise, $Z{=}100$, $\beta {=}0.1$. LLM frequencies pool high-confidence ($\tau \geq 0.9$) trajectories of Claude~3.5~Haiku, GPT-4o, and Mistral~Large across all five languages at the matching $\lambda $, with composite (multi-rule) labels expanded into one row per matched canonical strategy so the distribution is consistent with Tables~\ref {tab:strategy_by_llm}--\ref {tab:language_strategy_distribution} and Figure~\ref {fig:strategy_trends_payoff}. At low stakes ($\lambda {=}0.1$) the two distributions agree on the ALLD-leading ranking but already disagree on the ALLC mass. As $\lambda $ rises, EGT concentrates virtually all mass on ALLD ($\approx 97\%$ at $\lambda {=}10$) while the LLM mix moves in the opposite direction, with ALLC and WSLS gaining share and ALLD declining to $\approx 18\%$.}}{12}{figure.8}\protected@file@percent }
\newlabel{fig:egt_vs_llm_bar}{{8}{12}{\textbf {EGT stationary distribution (blue) vs.\ LLM empirical distribution (red) at $\lambda \in \{0.1, 1, 10\}$.} EGT computed analytically under the small-mutation limit with the FAIRGAME penalty matrix scaled by $\lambda $, $r{=}10$ rounds, $\varepsilon {=}0.05$ implementation noise, $Z{=}100$, $\beta {=}0.1$. LLM frequencies pool high-confidence ($\tau \geq 0.9$) trajectories of Claude~3.5~Haiku, GPT-4o, and Mistral~Large across all five languages at the matching $\lambda $, with composite (multi-rule) labels expanded into one row per matched canonical strategy so the distribution is consistent with Tables~\ref {tab:strategy_by_llm}--\ref {tab:language_strategy_distribution} and Figure~\ref {fig:strategy_trends_payoff}. At low stakes ($\lambda {=}0.1$) the two distributions agree on the ALLD-leading ranking but already disagree on the ALLC mass. As $\lambda $ rises, EGT concentrates virtually all mass on ALLD ($\approx 97\%$ at $\lambda {=}10$) while the LLM mix moves in the opposite direction, with ALLC and WSLS gaining share and ALLD declining to $\approx 18\%$}{figure.8}{}}
\newlabel{fig:egt_vs_llm_bar@cref}{{[figure][8][]8}{[1][12][]12}}
