\@writefile{lof}{\contentsline {figure}{\numberline {B.11}{\ignorespaces Strategy distribution by language, faceted per LLM (Claude~3.5, GPT-4o, Mistral, Llama~3.1~405B). The Arabic/Vietnamese vs.\ English/French/Chinese cluster split observed in Figure~\ref {fig:language_effect_appendix} is reproduced inside every model, so it is not driven by any single LLM's idiosyncrasies.}}{13}{figure.B.11}\protected@file@percent }
\newlabel{fig:language_effect_per_model_appendix}{{B.11}{13}{Strategy distribution by language, faceted per LLM (Claude~3.5, GPT-4o, Mistral, Llama~3.1~405B). The Arabic/Vietnamese vs.\ English/French/Chinese cluster split observed in Figure~\ref {fig:language_effect_appendix} is reproduced inside every model, so it is not driven by any single LLM's idiosyncrasies}{figure.B.11}{}}
