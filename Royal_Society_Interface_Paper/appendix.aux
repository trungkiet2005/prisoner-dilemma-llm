\newlabel{appendix:ml@cref}{{[subsubappendix][4][2147483647,2,5]B.5.4}{[1][13][]13}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.12}{\ignorespaces \textbf  {The language effect.} (a) Mean cumulative per-agent score by prompt language (sum of per-round penalties; higher = more total payoff). Agent~2 outperforms Agent~1 in every language, and absolute scores are highest in Arabic and Vietnamese -- the same languages that elicit the highest ALLD rates in panel~(b). (b) Strategy distribution by language pooled across all four LLMs: Arabic and Vietnamese cluster apart from English, French and Chinese on the ALLD axis, while ALLC is approximately language-invariant.}}{14}{figure.B.12}\protected@file@percent }
\newlabel{fig:language_effect}{{B.12}{14}{\textbf {The language effect.} (a) Mean cumulative per-agent score by prompt language (sum of per-round penalties; higher = more total payoff). Agent~2 outperforms Agent~1 in every language, and absolute scores are highest in Arabic and Vietnamese -- the same languages that elicit the highest ALLD rates in panel~(b). (b) Strategy distribution by language pooled across all four LLMs: Arabic and Vietnamese cluster apart from English, French and Chinese on the ALLD axis, while ALLC is approximately language-invariant}{figure.B.12}{}}
\newlabel{fig:language_effect@cref}{{[figure][12][2147483647,2]B.12}{[1][14][]14}}
