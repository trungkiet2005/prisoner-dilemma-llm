\@writefile{lof}{\contentsline {figure}{\numberline {B.10}{\ignorespaces Strategy distribution across languages on the baseline FAIRGAME dataset, pooled across all four proprietary LLMs. Arabic and Vietnamese stand apart with markedly higher ALLD shares, while English, French and Chinese cluster together at much lower defection rates.}}{13}{figure.B.10}\protected@file@percent }
\newlabel{fig:language_effect_appendix}{{B.10}{13}{Strategy distribution across languages on the baseline FAIRGAME dataset, pooled across all four proprietary LLMs. Arabic and Vietnamese stand apart with markedly higher ALLD shares, while English, French and Chinese cluster together at much lower defection rates}{figure.B.10}{}}
