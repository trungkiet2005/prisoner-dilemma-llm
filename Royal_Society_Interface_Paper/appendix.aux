\@writefile{lof}{\contentsline {figure}{\numberline {A.3}{\ignorespaces Model robustness to noise. Comparison of accuracy and F1-score between Logistic Regression, Random Forest, and LSTM on no-noise and noise $0.05$ datasets. The LSTM demonstrates superior resilience to execution noise.}}{5}{figure.A.3}\protected@file@percent }
