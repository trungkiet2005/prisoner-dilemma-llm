      \field{journaltitle}{Cognitive Systems Research}
      \field{month}{8}
      \field{shorttitle}{When to (or not to) trust intelligent machines}
      \field{title}{When to (or not to) trust intelligent machines: {Insights} from an evolutionary game theory analysis of trust in repeated games}
