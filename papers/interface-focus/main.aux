\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {The evolutionary baseline and the corpus move in opposite directions.} (a) The baseline's stationary distribution over the four canonical rules across the ten payoff scales, drawn as a stacked band. (b) The corpus's strategy mix on the same axis, drawn identically. (c) The AllD share alone, both accounts on one axis, with the gap shaded. Baseline at $Z = 100$, $\beta = 0.1$, $\epsilon = 0.05$, ten rounds; the corpus pooled over five models, five languages and four persona pairings.}}{16}{figure.caption.9}\protected@file@percent }
\newlabel{fig:egtllm}{{6}{16}{\textbf {The evolutionary baseline and the corpus move in opposite directions.} (a) The baseline's stationary distribution over the four canonical rules across the ten payoff scales, drawn as a stacked band. (b) The corpus's strategy mix on the same axis, drawn identically. (c) The AllD share alone, both accounts on one axis, with the gap shaded. Baseline at $Z = 100$, $\beta = 0.1$, $\epsilon = 0.05$, ten rounds; the corpus pooled over five models, five languages and four persona pairings}{figure.caption.9}{}}
