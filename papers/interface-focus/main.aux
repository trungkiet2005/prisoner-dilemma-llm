\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {How closely play follows the canonical memory-one rules, against the payoff scale.} Both panels are computed by exact matching, with no learned component. (a) Share of agent-games matched exactly by one canonical rule, one line per model, annotated with that model's trend per decade of $\lambda $; all five trends are negative, and only in GPT-5.4 Nano is the trend not distinguishable from zero (table~\ref {tab:strategy}). The shaded band marks the two scales at which every payoff printed is at most 1. (b) Mean number of rounds, out of the ten played, violating the nearest canonical rule. Here the trends do not all have the same sign: Grok 4.20 runs against the other four (table~\ref {tab:strategy}).}}{11}{figure.6}\protected@file@percent }
\newlabel{fig:ruleforce}{{6}{11}{\textbf {How closely play follows the canonical memory-one rules, against the payoff scale.} Both panels are computed by exact matching, with no learned component. (a) Share of agent-games matched exactly by one canonical rule, one line per model, annotated with that model's trend per decade of $\lam $; all five trends are negative, and only in GPT-5.4 Nano is the trend not distinguishable from zero (table~\ref {tab:strategy}). The shaded band marks the two scales at which every payoff printed is at most 1. (b) Mean number of rounds, out of the ten played, violating the nearest canonical rule. Here the trends do not all have the same sign: Grok 4.20 runs against the other four (table~\ref {tab:strategy})}{figure.6}{}}
\newlabel{fig:ruleforce@cref}{{[figure][6][]6}{[1][10][]11}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Share of agent-games carrying each canonical label, against the payoff scale.} One panel per canonical rule: (a) AllC, (b) Tit-for-Tat, (c) Win-Stay--Lose-Shift, (d) AllD. Each point is the share of that model's 400 agent-games at that scale carrying the label, and shaded bands mark the two scales at which every payoff printed is at most 1. The AllC and AllD panels rest partly on exact rule matching, whereas over the corpus $94.6\%$ of the Tit-for-Tat labels and $97.1\%$ of the Win-Stay--Lose-Shift labels are attributions made where no canonical rule fits, so those two panels should be read as a resemblance rather than as an identification.}}{11}{figure.7}\protected@file@percent }
\newlabel{fig:mix}{{7}{11}{\textbf {Share of agent-games carrying each canonical label, against the payoff scale.} One panel per canonical rule: (a) AllC, (b) Tit-for-Tat, (c) Win-Stay--Lose-Shift, (d) AllD. Each point is the share of that model's 400 agent-games at that scale carrying the label, and shaded bands mark the two scales at which every payoff printed is at most 1. The AllC and AllD panels rest partly on exact rule matching, whereas over the corpus $94.6\%$ of the Tit-for-Tat labels and $97.1\%$ of the Win-Stay--Lose-Shift labels are attributions made where no canonical rule fits, so those two panels should be read as a resemblance rather than as an identification}{figure.7}{}}
\newlabel{fig:mix@cref}{{[figure][7][]7}{[1][10][]11}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Cooperation on the opening move, against the payoff scale.} At round 1 the agent has seen only the matrix and the instructions. (a) Cooperation on the opening move, one curve per model. (b) Range of cooperation across the ten scales, on the opening move (solid) and over rounds 2 to 10 (hatched).}}{12}{figure.8}\protected@file@percent }
\newlabel{fig:firstmove}{{8}{12}{\textbf {Cooperation on the opening move, against the payoff scale.} At round 1 the agent has seen only the matrix and the instructions. (a) Cooperation on the opening move, one curve per model. (b) Range of cooperation across the ten scales, on the opening move (solid) and over rounds 2 to 10 (hatched)}{figure.8}{}}
\newlabel{fig:firstmove@cref}{{[figure][8][]8}{[1][10][]12}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.8}What the agents condition on}{12}{subsection.3.8}\protected@file@percent }
\newlabel{sec:conditioning}{{3.8}{12}{What the agents condition on}{subsection.3.8}{}}
\newlabel{sec:conditioning@cref}{{[subsection][8][3]3.8}{[1][12][]12}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {The deterministic dynamics do not see the payoff scale.} Replicator flow on each of the four faces of the three-simplex spanned by the canonical rules, one face per strategy left out, at $\lambda = 1$, $\epsilon = 0.05$ and ten rounds. Filled circles are stable rest points, open circles unstable. Only one row is drawn because rescaling the payoffs multiplies the field by a constant and moves nothing: the matrix at $\lambda = 1000$ is exactly $10^{5}$ times the matrix at $\lambda = 0.01$, and over 2{,}000 random population states the normalised fields agree to $4 \times 10^{-14}$.}}{13}{figure.9}\protected@file@percent }
\newlabel{fig:simplex}{{9}{13}{\textbf {The deterministic dynamics do not see the payoff scale.} Replicator flow on each of the four faces of the three-simplex spanned by the canonical rules, one face per strategy left out, at $\lam = 1$, $\epsilon = 0.05$ and ten rounds. Filled circles are stable rest points, open circles unstable. Only one row is drawn because rescaling the payoffs multiplies the field by a constant and moves nothing: the matrix at $\lam = 1000$ is exactly $10^{5}$ times the matrix at $\lam = 0.01$, and over 2{,}000 random population states the normalised fields agree to $4 \times 10^{-14}$}{figure.9}{}}
\newlabel{fig:simplex@cref}{{[figure][9][]9}{[1][13][]13}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Discussion}{13}{section.4}\protected@file@percent }
\newlabel{sec:discussion}{{4}{13}{Discussion}{section.4}{}}
\newlabel{sec:discussion@cref}{{[section][4][]4}{[1][13][]13}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Payoff-scale invariance is violated}{13}{subsection.4.1}\protected@file@percent }
\newlabel{sec:disc_invariance}{{4.1}{13}{Payoff-scale invariance is violated}{subsection.4.1}{}}
\newlabel{sec:disc_invariance@cref}{{[subsection][1][4]4.1}{[1][13][]13}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Heterogeneity, and why pooled designs miss it}{13}{subsection.4.2}\protected@file@percent }
\newlabel{sec:disc_pooling}{{4.2}{13}{Heterogeneity, and why pooled designs miss it}{subsection.4.2}{}}
\newlabel{sec:disc_pooling@cref}{{[subsection][2][4]4.2}{[1][13][]13}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Where the payoff scale does act: the invasion structure of a finite population.} Nodes are the four monomorphic states, node area is the small-mutation-limit stationary probability, and an edge is drawn where a single mutant fixes more often than neutral drift $1/Z$ would carry it, labelled in multiples of that drift. $Z = 100$, Fermi pairwise comparison, $\beta = 0.1$, $\epsilon = 0.05$. Because $\lambda $ and $\beta $ enter the update rule only through their product, raising the scale is raising selection pressure. The panels stop at $\lambda = 10$ because the float64 fixation probabilities underflow beyond it; those cells are solved at 200 digits instead (appendix~\ref {appendix:egt}).}}{14}{figure.10}\protected@file@percent }
\newlabel{fig:invasion}{{10}{14}{\textbf {Where the payoff scale does act: the invasion structure of a finite population.} Nodes are the four monomorphic states, node area is the small-mutation-limit stationary probability, and an edge is drawn where a single mutant fixes more often than neutral drift $1/Z$ would carry it, labelled in multiples of that drift. $Z = 100$, Fermi pairwise comparison, $\beta = 0.1$, $\epsilon = 0.05$. Because $\lam $ and $\beta $ enter the update rule only through their product, raising the scale is raising selection pressure. The panels stop at $\lam = 10$ because the float64 fixation probabilities underflow beyond it; those cells are solved at 200 digits instead (appendix~\ref {appendix:egt})}{figure.10}{}}
\newlabel{fig:invasion@cref}{{[figure][10][]10}{[1][13][]14}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {The evolutionary baseline and the corpus move in opposite directions.} (a) The baseline's stationary distribution over the four canonical rules across the ten payoff scales, drawn as a stacked band. (b) The corpus's strategy mix on the same axis, drawn identically. (c) The AllD share alone, both accounts on one axis, with the gap shaded. Baseline at $Z = 100$, $\beta = 0.1$, $\epsilon = 0.05$, ten rounds; the corpus pooled over five models, five languages and four persona pairings.}}{14}{figure.11}\protected@file@percent }
\newlabel{fig:egtllm}{{11}{14}{\textbf {The evolutionary baseline and the corpus move in opposite directions.} (a) The baseline's stationary distribution over the four canonical rules across the ten payoff scales, drawn as a stacked band. (b) The corpus's strategy mix on the same axis, drawn identically. (c) The AllD share alone, both accounts on one axis, with the gap shaded. Baseline at $Z = 100$, $\beta = 0.1$, $\epsilon = 0.05$, ten rounds; the corpus pooled over five models, five languages and four persona pairings}{figure.11}{}}
\newlabel{fig:egtllm@cref}{{[figure][11][]11}{[1][13][]14}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {The baseline's direction is a property of the model, not of its parameters.} (a) The AllD share against the payoff scale, one hairline per evolutionary setting, with the setting reported in the text drawn heavy. (b) The rise in the AllD share from the smallest scale to the largest, by execution error. (c) The corpus on the same axis as the family. Eighty settings, $Z \in \{50, 100, 200, 500\}$ crossed with $\beta \in \{0.01, 0.05, 0.1, 0.5, 1\}$ and $\epsilon \in \{0, 0.05, 0.1, 0.2\}$, ten payoff scales, 800 cells each solved at 200 significant digits. The rise is monotone at every positive $\epsilon $; all 19 exceptions are at $\epsilon = 0$.}}{15}{figure.12}\protected@file@percent }
\newlabel{fig:robustness}{{12}{15}{\textbf {The baseline's direction is a property of the model, not of its parameters.} (a) The AllD share against the payoff scale, one hairline per evolutionary setting, with the setting reported in the text drawn heavy. (b) The rise in the AllD share from the smallest scale to the largest, by execution error. (c) The corpus on the same axis as the family. Eighty settings, $Z \in \{50, 100, 200, 500\}$ crossed with $\beta \in \{0.01, 0.05, 0.1, 0.5, 1\}$ and $\epsilon \in \{0, 0.05, 0.1, 0.2\}$, ten payoff scales, 800 cells each solved at 200 significant digits. The rise is monotone at every positive $\epsilon $; all 19 exceptions are at $\epsilon = 0$}{figure.12}{}}
\newlabel{fig:robustness@cref}{{[figure][12][]12}{[1][13][]15}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \textbf  {The agents condition on themselves, not on their partner.} (a) Cells in the reciprocity by persistence plane, with the canonical rules at their exact coordinates; AllC, AllD and win-stay lose-shift all have both main effects zero and so coincide at the origin. (b) The three contrasts per model, against the value each canonical rule would give, with 95\% bootstrap intervals over cells. (c) The first two principal components of the raw five-vector, which is given no knowledge of the contrasts and recovers the same geometry. A cell is one model, payoff scale and prompt language; a predecessor observed fewer than thirty times yields no estimate and the cell is dropped, leaving 212 of 250.}}{15}{figure.13}\protected@file@percent }
\newlabel{fig:strategyspace}{{13}{15}{\textbf {The agents condition on themselves, not on their partner.} (a) Cells in the reciprocity by persistence plane, with the canonical rules at their exact coordinates; AllC, AllD and win-stay lose-shift all have both main effects zero and so coincide at the origin. (b) The three contrasts per model, against the value each canonical rule would give, with 95\% bootstrap intervals over cells. (c) The first two principal components of the raw five-vector, which is given no knowledge of the contrasts and recovers the same geometry. A cell is one model, payoff scale and prompt language; a predecessor observed fewer than thirty times yields no estimate and the cell is dropped, leaving 212 of 250}{figure.13}{}}
\newlabel{fig:strategyspace@cref}{{[figure][13][]13}{[1][13][]15}{}{}{}}
