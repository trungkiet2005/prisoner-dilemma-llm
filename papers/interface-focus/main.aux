\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Persona effect and sub-unit inversion against the payoff scale.} The persona effect is the cooperation rate under the cooperative persona minus that under the selfish persona. (a) Difference in cooperation rate across scales $\lambda $, with the sub-unit regime ($\lambda \le 0.1$) shaded where all five models cooperate more under the selfish prompt. (b) Regime means comparing sub-unit ($\lambda \le 0.1$, open circles) with supra-unit ($\lambda \ge 0.25$, filled circles) regimes (table~\ref {tab:persona}).}}{13}{figure.caption.7}\protected@file@percent }
\newlabel{fig:persona}{{4}{13}{\textbf {Persona effect and sub-unit inversion against the payoff scale.} The persona effect is the cooperation rate under the cooperative persona minus that under the selfish persona. (a) Difference in cooperation rate across scales $\lam $, with the sub-unit regime ($\lam \le 0.1$) shaded where all five models cooperate more under the selfish prompt. (b) Regime means comparing sub-unit ($\lam \le 0.1$, open circles) with supra-unit ($\lam \ge 0.25$, filled circles) regimes (table~\ref {tab:persona})}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5} Payoff scale alters strategic composition, not merely cooperation rates}{13}{subsection.3.5}\protected@file@percent }
\newlabel{sec:llm_strategies}{{3.5}{13}{Payoff scale alters strategic composition, not merely cooperation rates}{subsection.3.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Strategy attribution across payoff scales, composition shift, and provenance breakdown.} (a) Stacked area share of canonical memory-one strategy attributions (AllC, AllD, TFT, WSLS) across the ten payoff scales for each of the five models. (b) Net strategy share changes between extreme scales ($\lambda = 10^{3}$ minus $\lambda = 0.01$) across the four canonical rules with total variation distance $D_{\mathrm  {TV}}$ in parentheses. (c) Strategy read-out provenance: exactly deduced (single canonical match), ambiguous (multiple matching rules), and unmatched (LSTM attribution on trajectories consistent with no standard rule). Over the corpus, $94.6\%$ of Tit-for-Tat and $97.1\%$ of Win-Stay-Lose-Shift labels are attributions on unmatched play, establishing that labels indicate resemblance rather than faithful execution.}}{14}{figure.caption.8}\protected@file@percent }
\newlabel{fig:mix}{{5}{14}{\textbf {Strategy attribution across payoff scales, composition shift, and provenance breakdown.} (a) Stacked area share of canonical memory-one strategy attributions (AllC, AllD, TFT, WSLS) across the ten payoff scales for each of the five models. (b) Net strategy share changes between extreme scales ($\lam = 10^{3}$ minus $\lam = 0.01$) across the four canonical rules with total variation distance $D_{\mathrm {TV}}$ in parentheses. (c) Strategy read-out provenance: exactly deduced (single canonical match), ambiguous (multiple matching rules), and unmatched (LSTM attribution on trajectories consistent with no standard rule). Over the corpus, $94.6\%$ of Tit-for-Tat and $97.1\%$ of Win-Stay-Lose-Shift labels are attributions on unmatched play, establishing that labels indicate resemblance rather than faithful execution}{figure.caption.8}{}}
