\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Cooperation rates as a function of the payoff scale across five frontier models.} (a) Model-by-scale cooperation matrix: mean cooperation for each of the five models at each of the ten payoff scales $\lambda \in [0.01, 1000]$, with the value shown in each box. (b) Within-model cooperation range (maximum minus minimum rate across the ten scales) compared against the pooled five-model range (0.154, vertical dashed line). Confidence intervals are 95\% percentile intervals from 1{,}500 whole-dyad bootstrap resamples. (c) Small multiples per model: the focal model is drawn with its designated colour and marker, with the other four models shown behind in grey for context. Shaded bands mark the sub-unit regime ($\lambda \leq 0.1$). Each model-by-scale cell pools 200 dyads (400 agent-games), 20{,}000 agent-games in all.}}{9}{figure.caption.2}\protected@file@percent }
\newlabel{fig:landscape}{{2}{9}{\textbf {Cooperation rates as a function of the payoff scale across five frontier models.} (a) Model-by-scale cooperation matrix: mean cooperation for each of the five models at each of the ten payoff scales $\lam \in [0.01, 1000]$, with the value shown in each box. (b) Within-model cooperation range (maximum minus minimum rate across the ten scales) compared against the pooled five-model range (0.154, vertical dashed line). Confidence intervals are 95\% percentile intervals from 1{,}500 whole-dyad bootstrap resamples. (c) Small multiples per model: the focal model is drawn with its designated colour and marker, with the other four models shown behind in grey for context. Shaded bands mark the sub-unit regime ($\lam \leq 0.1$). Each model-by-scale cell pools 200 dyads (400 agent-games), 20{,}000 agent-games in all}{figure.caption.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Effect sizes vary across prompt languages}{9}{subsection.3.2}\protected@file@percent }
\newlabel{sec:language}{{3.2}{9}{Effect sizes vary across prompt languages}{subsection.3.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Cooperation over the ten payoff scales, by model.} Minimum, maximum and range, with a 95\% confidence interval on the range from a bootstrap over whole dyads and a permutation test on the payoff-scale label ($0.0005$ is the floor of 2{,}000 draws). The last two columns test the nine scale contrasts jointly in a per-model logistic regression of the round-level decision, clustered on the dyad. Each entry pools 200 dyads per scale; ranges are computed before rounding. Full specification in the electronic supplementary material.}}{10}{table.caption.3}\protected@file@percent }
\newlabel{tab:effect}{{1}{10}{\textbf {Cooperation over the ten payoff scales, by model.} Minimum, maximum and range, with a 95\% confidence interval on the range from a bootstrap over whole dyads and a permutation test on the payoff-scale label ($0.0005$ is the floor of 2{,}000 draws). The last two columns test the nine scale contrasts jointly in a per-model logistic regression of the round-level decision, clustered on the dyad. Each entry pools 200 dyads per scale; ranges are computed before rounding. Full specification in the electronic supplementary material}{table.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Persona effect below and above the sub-unit boundary, by model.} Cooperation under a cooperative persona minus cooperation under a selfish one, at the two scales where every printed payoff is at most 1 ($\lambda \leq 0.1$) and at the eight where some payoff exceeds it. Intervals are 95\% confidence intervals from the dyad bootstrap. A sign flip needs both regime intervals to exclude zero on opposite sides, so a supra-unit interval straddling zero means the effect is abolished rather than reversed.}}{10}{table.caption.4}\protected@file@percent }
\newlabel{tab:persona}{{2}{10}{\textbf {Persona effect below and above the sub-unit boundary, by model.} Cooperation under a cooperative persona minus cooperation under a selfish one, at the two scales where every printed payoff is at most 1 ($\lam \leq 0.1$) and at the eight where some payoff exceeds it. Intervals are 95\% confidence intervals from the dyad bootstrap. A sign flip needs both regime intervals to exclude zero on opposite sides, so a supra-unit interval straddling zero means the effect is abolished rather than reversed}{table.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Rule agreement and rule distance against the payoff scale, by model.} Left, the share of agent-games matched exactly by one canonical rule, below and above the sub-unit boundary, with the coefficient of a logistic regression of that indicator on $\log _{10}\lambda $; right, the mean number of rounds violating the nearest canonical rule at the smallest and largest scale, with the same trend by least squares. Both $\beta $ are per decade of $\lambda $ and their signs differ between models. Both cluster on the dyad, and neither block uses the learned classifier.}}{11}{table.caption.5}\protected@file@percent }
\newlabel{tab:strategy}{{3}{11}{\textbf {Rule agreement and rule distance against the payoff scale, by model.} Left, the share of agent-games matched exactly by one canonical rule, below and above the sub-unit boundary, with the coefficient of a logistic regression of that indicator on $\log _{10}\lam $; right, the mean number of rounds violating the nearest canonical rule at the smallest and largest scale, with the same trend by least squares. Both $\beta $ are per decade of $\lam $ and their signs differ between models. Both cluster on the dyad, and neither block uses the learned classifier}{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Cross-lingual scale sensitivity.} (a) Cooperation pooled across the five main-text models for each prompt language and payoff scale; the dashed boundary separates the sub-unit and supra-unit regimes. (b) Language-specific difference in cooperation between supra-unit and sub-unit regimes; intervals show the pooled estimate and small markers the five models separately. (c) Cooperation curves after subtracting each language's mean, showing that differences in scale-response shape remain after level differences are removed.}}{11}{figure.caption.6}\protected@file@percent }
\newlabel{fig:language}{{3}{11}{\textbf {Cross-lingual scale sensitivity.} (a) Cooperation pooled across the five main-text models for each prompt language and payoff scale; the dashed boundary separates the sub-unit and supra-unit regimes. (b) Language-specific difference in cooperation between supra-unit and sub-unit regimes; intervals show the pooled estimate and small markers the five models separately. (c) Cooperation curves after subtracting each language's mean, showing that differences in scale-response shape remain after level differences are removed}{figure.caption.6}{}}
