\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Persona effect and sub-unit inversion against the payoff scale.} The persona effect is the cooperation rate under the cooperative persona minus that under the selfish persona. (a) Difference in cooperation rate across scales $\lambda $, with the sub-unit regime ($\lambda \le 0.1$) shaded where all five models cooperate more under the selfish prompt. (b) Regime means comparing sub-unit ($\lambda \le 0.1$, open circles) with supra-unit ($\lambda \ge 0.25$, filled circles) regimes (table~\ref {tab:persona}).}}{14}{figure.caption.7}\protected@file@percent }
\newlabel{fig:persona}{{4}{14}{\textbf {Persona effect and sub-unit inversion against the payoff scale.} The persona effect is the cooperation rate under the cooperative persona minus that under the selfish persona. (a) Difference in cooperation rate across scales $\lam $, with the sub-unit regime ($\lam \le 0.1$) shaded where all five models cooperate more under the selfish prompt. (b) Regime means comparing sub-unit ($\lam \le 0.1$, open circles) with supra-unit ($\lam \ge 0.25$, filled circles) regimes (table~\ref {tab:persona})}{figure.caption.7}{}}
