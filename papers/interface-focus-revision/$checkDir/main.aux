\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Cooperation against the payoff scale across five frontier models.} (a) Model-by-scale cooperation matrix: mean cooperation for each of the five models at each of the ten payoff scales $\lambda \in [0.01, 1000]$, with the value printed in each tile. (b) Small multiples per model: the focal model is drawn with its designated colour and marker, with the other four models shown behind in grey for context. Shaded bands mark the sub-unit regime ($\lambda \leq 0.1$). (c) Within-model cooperation range (maximum minus minimum rate across the ten scales) compared against the pooled five-model range (0.154, vertical dashed line). Confidence intervals are 95\% percentile intervals from 1{,}500 whole-dyad bootstrap resamples.}}{7}{figure.16}\protected@file@percent }
\newlabel{fig:landscape}{{2}{7}{\textbf {Cooperation against the payoff scale across five frontier models.} (a) Model-by-scale cooperation matrix: mean cooperation for each of the five models at each of the ten payoff scales $\lam \in [0.01, 1000]$, with the value printed in each tile. (b) Small multiples per model: the focal model is drawn with its designated colour and marker, with the other four models shown behind in grey for context. Shaded bands mark the sub-unit regime ($\lam \leq 0.1$). (c) Within-model cooperation range (maximum minus minimum rate across the ten scales) compared against the pooled five-model range (0.154, vertical dashed line). Confidence intervals are 95\% percentile intervals from 1{,}500 whole-dyad bootstrap resamples}{figure.16}{}}
\newlabel{fig:landscape@cref}{{[figure][2][]2}{[1][7][]7}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Cooperation over the ten payoff scales, by model.} Minimum, maximum and range, with a 95\% confidence interval on the range from a bootstrap over whole dyads and a permutation test on the payoff-scale label ($0.0005$ is the floor of 2{,}000 draws). The last two columns test the nine scale contrasts jointly in a per-model logistic regression of the round-level decision, clustered on the dyad. Each entry pools 200 dyads per scale; ranges are computed before rounding. Full specification in the electronic supplementary material.}}{8}{table.18}\protected@file@percent }
\newlabel{tab:effect}{{1}{8}{\textbf {Cooperation over the ten payoff scales, by model.} Minimum, maximum and range, with a 95\% confidence interval on the range from a bootstrap over whole dyads and a permutation test on the payoff-scale label ($0.0005$ is the floor of 2{,}000 draws). The last two columns test the nine scale contrasts jointly in a per-model logistic regression of the round-level decision, clustered on the dyad. Each entry pools 200 dyads per scale; ranges are computed before rounding. Full specification in the electronic supplementary material}{table.18}{}}
\newlabel{tab:effect@cref}{{[table][1][]1}{[1][7][]8}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Persona effect below and above the sub-unit boundary, by model.} Cooperation under a cooperative persona minus cooperation under a selfish one, at the two scales where every printed payoff is at most 1 ($\lambda \leq 0.1$) and at the eight where some payoff exceeds it. Intervals are 95\% confidence intervals from the dyad bootstrap. A sign flip needs both regime intervals to exclude zero on opposite sides, so a supra-unit interval straddling zero means the effect is abolished rather than reversed.}}{8}{table.20}\protected@file@percent }
\newlabel{tab:persona}{{2}{8}{\textbf {Persona effect below and above the sub-unit boundary, by model.} Cooperation under a cooperative persona minus cooperation under a selfish one, at the two scales where every printed payoff is at most 1 ($\lam \leq 0.1$) and at the eight where some payoff exceeds it. Intervals are 95\% confidence intervals from the dyad bootstrap. A sign flip needs both regime intervals to exclude zero on opposite sides, so a supra-unit interval straddling zero means the effect is abolished rather than reversed}{table.20}{}}
\newlabel{tab:persona@cref}{{[table][2][]2}{[1][7][]8}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Rule agreement and rule distance against the payoff scale, by model.} Left, the share of agent-games matched exactly by one canonical rule, below and above the sub-unit boundary, with the coefficient of a logistic regression of that indicator on $\log _{10}\lambda $; right, the mean number of rounds violating the nearest canonical rule at the smallest and largest scale, with the same trend by least squares. Both $\beta $ are per decade of $\lambda $ and their signs differ between models. Both cluster on the dyad, and neither block uses the learned classifier.}}{8}{table.22}\protected@file@percent }
\newlabel{tab:strategy}{{3}{8}{\textbf {Rule agreement and rule distance against the payoff scale, by model.} Left, the share of agent-games matched exactly by one canonical rule, below and above the sub-unit boundary, with the coefficient of a logistic regression of that indicator on $\log _{10}\lam $; right, the mean number of rounds violating the nearest canonical rule at the smallest and largest scale, with the same trend by least squares. Both $\beta $ are per decade of $\lam $ and their signs differ between models. Both cluster on the dyad, and neither block uses the learned classifier}{table.22}{}}
\newlabel{tab:strategy@cref}{{[table][3][]3}{[1][7][]8}}
