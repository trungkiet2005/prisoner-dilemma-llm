\@writefile{lof}{\contentsline {figure}{\numberline {B.3}{\ignorespaces \textbf  {Opening-move sensitivity to payoff scale and persona.} At round 1 the agent has observed only the matrix and instructions, with zero interaction history. (a) Opening-move cooperation across payoff scales for the five models reported in the main text. (b) Opening-move cooperation against cooperation over all ten rounds across the 50 model-by-scale cells, with within-model correlations annotated. (c) Opening-move persona effect in the sub-unit and supra-unit regimes.}}{11}{figure.caption.11}\protected@file@percent }
\newlabel{fig:firstmove_supp}{{B.3}{11}{\textbf {Opening-move sensitivity to payoff scale and persona.} At round 1 the agent has observed only the matrix and instructions, with zero interaction history. (a) Opening-move cooperation across payoff scales for the five models reported in the main text. (b) Opening-move cooperation against cooperation over all ten rounds across the 50 model-by-scale cells, with within-model correlations annotated. (c) Opening-move persona effect in the sub-unit and supra-unit regimes}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.4}{\ignorespaces \textbf  {The scaling mechanism: ex-ante policy re-weighting versus within-game dynamics.} (a) Share of agent-games playing never-cooperate ($c=0$), interior mixed strategies, and always-cooperate ($c=1$) across the ten payoff scales $\lambda $. The never-cooperate share drops from $21.3\%$ at $\lambda = 0.01$ to $8.9\%$ at $\lambda = 1000$. (b) Opposing trajectories of the two boundary atoms against $\log _{10}\lambda $: the always-cooperate share rises modestly (Spearman $\rho = +0.05$), while the never-cooperate share falls substantially (Spearman $\rho = -0.47$), showing that the scale effect is concentrated in the relief of unconditional defection at sub-unit stakes. (c) Round-by-round cooperation rate across rounds 1 to 10 for three anchor scales ($\lambda = 0.01$, $\lambda = 1.0$, and $\lambda = 1000$). The similar decay curves are consistent with, but do not establish, an early effect of payoff magnitude.}}{12}{figure.caption.12}\protected@file@percent }
\newlabel{fig:mechanism}{{B.4}{12}{\textbf {The scaling mechanism: ex-ante policy re-weighting versus within-game dynamics.} (a) Share of agent-games playing never-cooperate ($c=0$), interior mixed strategies, and always-cooperate ($c=1$) across the ten payoff scales $\lam $. The never-cooperate share drops from $21.3\%$ at $\lam = 0.01$ to $8.9\%$ at $\lam = 1000$. (b) Opposing trajectories of the two boundary atoms against $\log _{10}\lam $: the always-cooperate share rises modestly (Spearman $\rho = +0.05$), while the never-cooperate share falls substantially (Spearman $\rho = -0.47$), showing that the scale effect is concentrated in the relief of unconditional defection at sub-unit stakes. (c) Round-by-round cooperation rate across rounds 1 to 10 for three anchor scales ($\lam = 0.01$, $\lam = 1.0$, and $\lam = 1000$). The similar decay curves are consistent with, but do not establish, an early effect of payoff magnitude}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {B.9}Outcome fairness, net exploitation and the V-shaped welfare frontier}{12}{subsection.B.9}\protected@file@percent }
\newlabel{appendix:fairness_welfare}{{B.9}{12}{Outcome fairness, net exploitation and the V-shaped welfare frontier}{subsection.B.9}{}}
\newlabel{eq:fairness_identity}{{1}{12}{Outcome fairness, net exploitation and the V-shaped welfare frontier}{equation.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.5}{\ignorespaces \textbf  {Outcome fairness, net exploitation and the V-shaped welfare frontier.} (a) Within-dyad fairness ($1 - \text  {Gini}$) plotted against joint dyad welfare across all experimental conditions, revealing a characteristic V-shaped relationship where equality peaks at both mutual defection (low welfare) and mutual cooperation (high welfare), with inequality concentrated in the exploitative transition zone. (b) Per-model fairness trajectories showing how different models occupy distinct regimes along the welfare-fairness frontier. (c) Distributional equity across the ten payoff scales: the fitted association is small and imprecise (slope $0.0004$, $p = 0.85$).}}{13}{figure.caption.13}\protected@file@percent }
\newlabel{fig:fairness_welfare}{{B.5}{13}{\textbf {Outcome fairness, net exploitation and the V-shaped welfare frontier.} (a) Within-dyad fairness ($1 - \text {Gini}$) plotted against joint dyad welfare across all experimental conditions, revealing a characteristic V-shaped relationship where equality peaks at both mutual defection (low welfare) and mutual cooperation (high welfare), with inequality concentrated in the exploitative transition zone. (b) Per-model fairness trajectories showing how different models occupy distinct regimes along the welfare-fairness frontier. (c) Distributional equity across the ten payoff scales: the fitted association is small and imprecise (slope $0.0004$, $p = 0.85$)}{figure.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.1}{\ignorespaces \textbf  {The corpus, by model.} Every model was run on the same ten payoff scales and five prompt languages. ``Cell $n$'' is the number of dyads in each model $\times $ language $\times $ scale cell; the design is balanced with none missing, and the build refuses to write its tables otherwise. The first five models are the ones the main text reports; Gemini 3.1 Flash-Lite is reported here, for the reason given with the sixth model below.}}{13}{table.caption.14}\protected@file@percent }
\newlabel{tab:S-corpus}{{B.1}{13}{\textbf {The corpus, by model.} Every model was run on the same ten payoff scales and five prompt languages. ``Cell $n$'' is the number of dyads in each model $\times $ language $\times $ scale cell; the design is balanced with none missing, and the build refuses to write its tables otherwise. The first five models are the ones the main text reports; Gemini 3.1 Flash-Lite is reported here, for the reason given with the sixth model below}{table.caption.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.2}{\ignorespaces \textbf  {Cooperation by model and payoff scale.} Each entry aggregates 200 dyads. The bracketed line under each model is a 95\% confidence interval from a bootstrap that resamples whole dyads.}}{14}{table.caption.15}\protected@file@percent }
\newlabel{tab:S-scale}{{B.2}{14}{\textbf {Cooperation by model and payoff scale.} Each entry aggregates 200 dyads. The bracketed line under each model is a 95\% confidence interval from a bootstrap that resamples whole dyads}{table.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.3}{\ignorespaces \textbf  {Cooperation by model, prompt language and payoff scale.} 40 dyads per entry. The final column is the range across the ten scales for that model and language; over all six models it runs from 0.080, for Gemini 3.1 Flash-Lite in Arabic, to 0.855, for Grok 4.20 in English, so the scale sensitivity of a model is a property of the model and the language jointly.}}{15}{table.caption.16}\protected@file@percent }
\newlabel{tab:S-language}{{B.3}{15}{\textbf {Cooperation by model, prompt language and payoff scale.} 40 dyads per entry. The final column is the range across the ten scales for that model and language; over all six models it runs from 0.080, for Gemini 3.1 Flash-Lite in Arabic, to 0.855, for Grok 4.20 in English, so the scale sensitivity of a model is a property of the model and the language jointly}{table.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.4}{\ignorespaces \textbf  {Variance decomposition of the cell means, five models.} Type-II analysis of variance on the 250 model $\times $ language $\times $ scale cell means of the five models the main text reports, where the design is exactly balanced. The payoff scale carries a significant main effect, and its interaction with the model carries three times as much of the variance.}}{16}{table.caption.17}\protected@file@percent }
\newlabel{tab:S-variance}{{B.4}{16}{\textbf {Variance decomposition of the cell means, five models.} Type-II analysis of variance on the 250 model $\times $ language $\times $ scale cell means of the five models the main text reports, where the design is exactly balanced. The payoff scale carries a significant main effect, and its interaction with the model carries three times as much of the variance}{table.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.5}{\ignorespaces \textbf  {Variance decomposition of the cell means, all six models.} The same type-II analysis on all 300 cell means, the sixth model included. Every term significant in the five-model table is significant here and in the same order: the model $\times $ scale interaction again carries several times the variance of the payoff scale as a main effect.}}{16}{table.caption.18}\protected@file@percent }
\newlabel{tab:S-variance-all}{{B.5}{16}{\textbf {Variance decomposition of the cell means, all six models.} The same type-II analysis on all 300 cell means, the sixth model included. Every term significant in the five-model table is significant here and in the same order: the model $\times $ scale interaction again carries several times the variance of the payoff scale as a main effect}{table.caption.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.6}{\ignorespaces \textbf  {Persona effect by model and payoff scale.} The cooperation rate of an agent instructed that it is cooperative minus that of an agent instructed that it is selfish, at each scale. The two leftmost columns are the scales at which every payoff printed is at most 1.}}{16}{table.caption.19}\protected@file@percent }
\newlabel{tab:S-persona}{{B.6}{16}{\textbf {Persona effect by model and payoff scale.} The cooperation rate of an agent instructed that it is cooperative minus that of an agent instructed that it is selfish, at each scale. The two leftmost columns are the scales at which every payoff printed is at most 1}{table.caption.19}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.7}{\ignorespaces \textbf  {Share of agent-games matched exactly by one canonical rule (\%).} Computed by exact rule matching, with no learned component. 400 agent-games per entry.}}{16}{table.caption.20}\protected@file@percent }
\newlabel{tab:S-deduced}{{B.7}{16}{\textbf {Share of agent-games matched exactly by one canonical rule (\%).} Computed by exact rule matching, with no learned component. 400 agent-games per entry}{table.caption.20}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.8}{\ignorespaces \textbf  {Strategy composition by model and payoff scale (\%).} The label assigned by the hybrid read-out: the rule base fixes the candidate set and the LSTM ranks within it, deciding alone only where no canonical rule fits. Columns sum to 100 within each model and scale.}}{17}{table.caption.21}\protected@file@percent }
\newlabel{tab:S-mix}{{B.8}{17}{\textbf {Strategy composition by model and payoff scale (\%).} The label assigned by the hybrid read-out: the rule base fixes the candidate set and the LSTM ranks within it, deciding alone only where no canonical rule fits. Columns sum to 100 within each model and scale}{table.caption.21}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.9}{\ignorespaces \textbf  {Provenance of each label.} For every label, the share of the agent-games carrying it that were deduced (exactly one canonical rule fits), ambiguous (several fit, and the LSTM ranked within that set) or unmatched (no canonical rule fits, so the label is an attribution the LSTM makes alone). The asymmetry is severe and bounds how the compositional result may be read: AllC and AllD carry a substantial deduced share, whereas the TFT and WSLS labels are almost entirely attributions.}}{17}{table.caption.22}\protected@file@percent }
\newlabel{tab:S-provenance}{{B.9}{17}{\textbf {Provenance of each label.} For every label, the share of the agent-games carrying it that were deduced (exactly one canonical rule fits), ambiguous (several fit, and the LSTM ranked within that set) or unmatched (no canonical rule fits, so the label is an attribution the LSTM makes alone). The asymmetry is severe and bounds how the compositional result may be read: AllC and AllD carry a substantial deduced share, whereas the TFT and WSLS labels are almost entirely attributions}{table.caption.22}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.10}{\ignorespaces \textbf  {Validation of the LSTM branch.} Trained on synthetic AllC / AllD / Tit-for-Tat / Win-Stay-Lose-Shift trajectories at zero and 5\% execution noise, balanced at 40{,}320 sequences per strategy per level. The 10\% and 20\% noise levels are never trained on. No language-model transcript enters training.}}{18}{table.caption.23}\protected@file@percent }
\newlabel{tab:S-classifier}{{B.10}{18}{\textbf {Validation of the LSTM branch.} Trained on synthetic AllC / AllD / Tit-for-Tat / Win-Stay-Lose-Shift trajectories at zero and 5\% execution noise, balanced at 40{,}320 sequences per strategy per level. The 10\% and 20\% noise levels are never trained on. No language-model transcript enters training}{table.caption.23}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.11}{\ignorespaces \textbf  {Pairwise correlation between the model curves, five models.} Correlation of the ten-point cooperation-against-scale curves of each pair of the five models the main text reports. Six of the ten pairs are negative and the mean is $-0.10$, which is why averaging the curves cancels much of the movement.}}{18}{table.caption.24}\protected@file@percent }
\newlabel{tab:S-shapes}{{B.11}{18}{\textbf {Pairwise correlation between the model curves, five models.} Correlation of the ten-point cooperation-against-scale curves of each pair of the five models the main text reports. Six of the ten pairs are negative and the mean is $-0.10$, which is why averaging the curves cancels much of the movement}{table.caption.24}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.12}{\ignorespaces \textbf  {Pairwise correlation between the model curves, all six models.} The same correlations with the sixth model included: nine of the fifteen pairs are negative and the mean is $-0.08$.}}{18}{table.caption.25}\protected@file@percent }
\newlabel{tab:S-shapes-all}{{B.12}{18}{\textbf {Pairwise correlation between the model curves, all six models.} The same correlations with the sixth model included: nine of the fifteen pairs are negative and the mean is $-0.08$}{table.caption.25}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.13}{\ignorespaces \textbf  {Range of cooperation across the ten payoff scales, on the opening move and afterwards.} At round 1 the agent has seen only the payoff matrix and the instructions, so a dependence on the payoff scale there cannot have come through the history of play. The two windows rest on 400 and 3{,}600 decisions per cell, so their ranges are not variance-matched and the ratio is descriptive rather than a test; the bias runs the same way in every model, while the ratio does not.}}{18}{table.caption.26}\protected@file@percent }
\newlabel{tab:S-firstmove}{{B.13}{18}{\textbf {Range of cooperation across the ten payoff scales, on the opening move and afterwards.} At round 1 the agent has seen only the payoff matrix and the instructions, so a dependence on the payoff scale there cannot have come through the history of play. The two windows rest on 400 and 3{,}600 decisions per cell, so their ranges are not variance-matched and the ratio is descriptive rather than a test; the bias runs the same way in every model, while the ratio does not}{table.caption.26}{}}
