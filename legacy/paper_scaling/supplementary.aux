\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces \textbf  {The corpus, by model.} Every model was run on the same ten payoff scales and five prompt languages. ``Cell $n$'' is the number of dyads in each model $\times $ language $\times $ scale cell; the design is balanced with none missing, and the build refuses to write its tables otherwise. The first five models are the ones the main text reports; Gemini 3.1 Flash-Lite is reported here, for the reason given in \S  S8.}}{8}{table.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:S-corpus}{{S1}{8}{\textbf {The corpus, by model.} Every model was run on the same ten payoff scales and five prompt languages. ``Cell $n$'' is the number of dyads in each model $\times $ language $\times $ scale cell; the design is balanced with none missing, and the build refuses to write its tables otherwise. The first five models are the ones the main text reports; Gemini 3.1 Flash-Lite is reported here, for the reason given in \S S8}{table.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces \textbf  {Cooperation by model and payoff scale.} Each entry aggregates 200 dyads. The bracketed line under each model is a 95\% confidence interval from a bootstrap that resamples whole dyads.}}{8}{table.caption.3}\protected@file@percent }
\newlabel{tab:S-scale}{{S2}{8}{\textbf {Cooperation by model and payoff scale.} Each entry aggregates 200 dyads. The bracketed line under each model is a 95\% confidence interval from a bootstrap that resamples whole dyads}{table.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces \textbf  {Cooperation by model, prompt language and payoff scale.} 40 dyads per entry. The final column is the range across the ten scales for that model and language; over all six models it runs from 0.080, for Gemini 3.1 Flash-Lite in Arabic, to 0.855, for Grok 4.20 in English, so the scale sensitivity of a model is a property of the model and the language jointly.}}{9}{table.caption.4}\protected@file@percent }
\newlabel{tab:S-language}{{S3}{9}{\textbf {Cooperation by model, prompt language and payoff scale.} 40 dyads per entry. The final column is the range across the ten scales for that model and language; over all six models it runs from 0.080, for Gemini 3.1 Flash-Lite in Arabic, to 0.855, for Grok 4.20 in English, so the scale sensitivity of a model is a property of the model and the language jointly}{table.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces \textbf  {Variance decomposition of the cell means, five models.} Type-II analysis of variance on the 250 model $\times $ language $\times $ scale cell means of the five models the main text reports, where the design is exactly balanced. The payoff scale carries a significant main effect, and its interaction with the model carries three times as much of the variance.}}{10}{table.caption.5}\protected@file@percent }
\newlabel{tab:S-variance}{{S4}{10}{\textbf {Variance decomposition of the cell means, five models.} Type-II analysis of variance on the 250 model $\times $ language $\times $ scale cell means of the five models the main text reports, where the design is exactly balanced. The payoff scale carries a significant main effect, and its interaction with the model carries three times as much of the variance}{table.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces \textbf  {Variance decomposition of the cell means, all six models.} The same type-II analysis on all 300 cell means, the sixth model included. Every term significant in the five-model table is significant here and in the same order: the model $\times $ scale interaction again carries several times the variance of the payoff scale as a main effect.}}{10}{table.caption.6}\protected@file@percent }
\newlabel{tab:S-variance-all}{{S5}{10}{\textbf {Variance decomposition of the cell means, all six models.} The same type-II analysis on all 300 cell means, the sixth model included. Every term significant in the five-model table is significant here and in the same order: the model $\times $ scale interaction again carries several times the variance of the payoff scale as a main effect}{table.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S6}{\ignorespaces \textbf  {Persona effect by model and payoff scale.} The cooperation rate of an agent instructed that it is cooperative minus that of an agent instructed that it is selfish, at each scale. The two leftmost columns are the scales at which every payoff printed is at most 1.}}{10}{table.caption.7}\protected@file@percent }
\newlabel{tab:S-persona}{{S6}{10}{\textbf {Persona effect by model and payoff scale.} The cooperation rate of an agent instructed that it is cooperative minus that of an agent instructed that it is selfish, at each scale. The two leftmost columns are the scales at which every payoff printed is at most 1}{table.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S7}{\ignorespaces \textbf  {Share of agent-games matched exactly by one canonical rule (\%).} Computed by exact rule matching, with no learned component. 400 agent-games per entry.}}{10}{table.caption.8}\protected@file@percent }
\newlabel{tab:S-deduced}{{S7}{10}{\textbf {Share of agent-games matched exactly by one canonical rule (\%).} Computed by exact rule matching, with no learned component. 400 agent-games per entry}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S8}{\ignorespaces \textbf  {Strategy composition by model and payoff scale (\%).} The label assigned by the hybrid read-out: the rule base fixes the candidate set and the LSTM ranks within it, deciding alone only where no canonical rule fits. Columns sum to 100 within each model and scale.}}{11}{table.caption.9}\protected@file@percent }
\newlabel{tab:S-mix}{{S8}{11}{\textbf {Strategy composition by model and payoff scale (\%).} The label assigned by the hybrid read-out: the rule base fixes the candidate set and the LSTM ranks within it, deciding alone only where no canonical rule fits. Columns sum to 100 within each model and scale}{table.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S9}{\ignorespaces \textbf  {Provenance of each label.} For every label, the share of the agent-games carrying it that were deduced (exactly one canonical rule fits), ambiguous (several fit, and the LSTM ranked within that set) or unmatched (no canonical rule fits, so the label is an attribution the LSTM makes alone). The asymmetry is severe and bounds how the compositional result may be read: AllC and AllD carry a substantial deduced share, whereas the TFT and WSLS labels are almost entirely attributions.}}{11}{table.caption.10}\protected@file@percent }
\newlabel{tab:S-provenance}{{S9}{11}{\textbf {Provenance of each label.} For every label, the share of the agent-games carrying it that were deduced (exactly one canonical rule fits), ambiguous (several fit, and the LSTM ranked within that set) or unmatched (no canonical rule fits, so the label is an attribution the LSTM makes alone). The asymmetry is severe and bounds how the compositional result may be read: AllC and AllD carry a substantial deduced share, whereas the TFT and WSLS labels are almost entirely attributions}{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S10}{\ignorespaces \textbf  {Validation of the LSTM branch.} Trained on synthetic AllC / AllD / Tit-for-Tat / Win-Stay-Lose-Shift trajectories at zero and 5\% execution noise, balanced at 40{,}320 sequences per strategy per level. The 10\% and 20\% noise levels are never trained on. No language-model transcript enters training.}}{12}{table.caption.11}\protected@file@percent }
\newlabel{tab:S-classifier}{{S10}{12}{\textbf {Validation of the LSTM branch.} Trained on synthetic AllC / AllD / Tit-for-Tat / Win-Stay-Lose-Shift trajectories at zero and 5\% execution noise, balanced at 40{,}320 sequences per strategy per level. The 10\% and 20\% noise levels are never trained on. No language-model transcript enters training}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S11}{\ignorespaces \textbf  {Pairwise correlation between the model curves, five models.} Correlation of the ten-point cooperation-against-scale curves of each pair of the five models the main text reports. Six of the ten pairs are negative and the mean is $-0.10$, which is why averaging the curves cancels much of the movement.}}{12}{table.caption.12}\protected@file@percent }
\newlabel{tab:S-shapes}{{S11}{12}{\textbf {Pairwise correlation between the model curves, five models.} Correlation of the ten-point cooperation-against-scale curves of each pair of the five models the main text reports. Six of the ten pairs are negative and the mean is $-0.10$, which is why averaging the curves cancels much of the movement}{table.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S12}{\ignorespaces \textbf  {Pairwise correlation between the model curves, all six models.} The same correlations with the sixth model included: nine of the fifteen pairs are negative and the mean is $-0.08$.}}{12}{table.caption.13}\protected@file@percent }
\newlabel{tab:S-shapes-all}{{S12}{12}{\textbf {Pairwise correlation between the model curves, all six models.} The same correlations with the sixth model included: nine of the fifteen pairs are negative and the mean is $-0.08$}{table.caption.13}{}}
