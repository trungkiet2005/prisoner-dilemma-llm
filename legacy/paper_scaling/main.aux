\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Cooperation against the payoff scale in five language models.} (a) The same prisoner's dilemma at three payoff scales, shown to the agent as penalties to be minimized. (b) Cooperation against the payoff scale, one curve per model; the shaded band marks the two scales at which every payoff printed is at most 1. (c) The curves of (b) centred within model, with their average in black. Each point in (b) and (c) averages 200 dyads, with 95\% percentile intervals from 1{,}500 bootstrap resamples of whole dyads.}}{9}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:scaling}{{1}{9}{\textbf {Cooperation against the payoff scale in five language models.} (a) The same prisoner's dilemma at three payoff scales, shown to the agent as penalties to be minimized. (b) Cooperation against the payoff scale, one curve per model; the shaded band marks the two scales at which every payoff printed is at most 1. (c) The curves of (b) centred within model, with their average in black. Each point in (b) and (c) averages 200 dyads, with 95\% percentile intervals from 1{,}500 bootstrap resamples of whole dyads}{figure.caption.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}The size of the scale effect depends on the prompt language}{9}{subsection.3.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Cooperation over the ten payoff scales, by model.} Minimum, maximum and range, with a 95\% confidence interval on the range from a bootstrap over whole dyads and a permutation test on the payoff-scale label ($0.0005$ is the floor of 2{,}000 draws). The last two columns test the nine scale contrasts jointly in a per-model logistic regression of the round-level decision, clustered on the dyad. Each entry pools 200 dyads per scale; ranges are computed before rounding. Full specification in the electronic supplementary material.}}{10}{table.caption.2}\protected@file@percent }
\newlabel{tab:effect}{{1}{10}{\textbf {Cooperation over the ten payoff scales, by model.} Minimum, maximum and range, with a 95\% confidence interval on the range from a bootstrap over whole dyads and a permutation test on the payoff-scale label ($0.0005$ is the floor of 2{,}000 draws). The last two columns test the nine scale contrasts jointly in a per-model logistic regression of the round-level decision, clustered on the dyad. Each entry pools 200 dyads per scale; ranges are computed before rounding. Full specification in the electronic supplementary material}{table.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Persona effect below and above the sub-unit boundary, by model.} Cooperation under a cooperative persona minus cooperation under a selfish one, at the two scales where every printed payoff is at most 1 ($\lambda \leq 0.1$) and at the eight where some payoff exceeds it. Intervals are 95\% confidence intervals from the dyad bootstrap. A sign flip needs both regime intervals to exclude zero on opposite sides, so a supra-unit interval straddling zero means the effect is abolished rather than reversed.}}{10}{table.caption.3}\protected@file@percent }
\newlabel{tab:persona}{{2}{10}{\textbf {Persona effect below and above the sub-unit boundary, by model.} Cooperation under a cooperative persona minus cooperation under a selfish one, at the two scales where every printed payoff is at most 1 ($\lam \leq 0.1$) and at the eight where some payoff exceeds it. Intervals are 95\% confidence intervals from the dyad bootstrap. A sign flip needs both regime intervals to exclude zero on opposite sides, so a supra-unit interval straddling zero means the effect is abolished rather than reversed}{table.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}The payoff scale gates the persona instruction}{10}{subsection.3.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Rule agreement and rule distance against the payoff scale, by model.} Left, the share of agent-games matched exactly by one canonical rule, below and above the sub-unit boundary, with the coefficient of a logistic regression of that indicator on $\log _{10}\lambda $; right, the mean number of rounds violating the nearest canonical rule at the smallest and largest scale, with the same trend by least squares. Both $\beta $ are per decade of $\lambda $ and their signs differ between models. Both cluster on the dyad, and neither block uses the learned classifier.}}{11}{table.caption.4}\protected@file@percent }
\newlabel{tab:strategy}{{3}{11}{\textbf {Rule agreement and rule distance against the payoff scale, by model.} Left, the share of agent-games matched exactly by one canonical rule, below and above the sub-unit boundary, with the coefficient of a logistic regression of that indicator on $\log _{10}\lam $; right, the mean number of rounds violating the nearest canonical rule at the smallest and largest scale, with the same trend by least squares. Both $\beta $ are per decade of $\lam $ and their signs differ between models. Both cluster on the dyad, and neither block uses the learned classifier}{table.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Cooperation against the payoff scale, by model and prompt language.} One panel per model, one curve per prompt language; the annotation gives the smallest and largest across-scale range among that model's five languages. Each point averages 40 dyads.}}{11}{figure.caption.5}\protected@file@percent }
\newlabel{fig:language}{{2}{11}{\textbf {Cooperation against the payoff scale, by model and prompt language.} One panel per model, one curve per prompt language; the annotation gives the smallest and largest across-scale range among that model's five languages. Each point averages 40 dyads}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}The scale also changes what is played}{11}{subsection.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The persona effect against the payoff scale.} The persona effect is the cooperation rate under a cooperative persona minus that under a selfish one. (a) The effect against the payoff scale, each point averaging 200 dyads; the shaded band marks the two scales at which every payoff printed is at most 1. (b) The same contrast as two regime means: open markers at $\lambda \leq 0.1$, filled markers at $\lambda \geq 0.25$ (table~\ref {tab:persona}).}}{12}{figure.caption.6}\protected@file@percent }
\newlabel{fig:persona}{{3}{12}{\textbf {The persona effect against the payoff scale.} The persona effect is the cooperation rate under a cooperative persona minus that under a selfish one. (a) The effect against the payoff scale, each point averaging 200 dyads; the shaded band marks the two scales at which every payoff printed is at most 1. (b) The same contrast as two regime means: open markers at $\lam \leq 0.1$, filled markers at $\lam \geq 0.25$ (table~\ref {tab:persona})}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {How closely play follows the canonical memory-one rules, against the payoff scale.} Both panels are computed by exact matching, with no learned component. (a) Provenance of the strategy read-out, pooled over the five models; the per-model trends, which do not all have the same sign, are in table~\ref {tab:strategy}. (b) Mean number of rounds, out of the ten played, violating the nearest canonical rule.}}{13}{figure.caption.7}\protected@file@percent }
\newlabel{fig:strategy}{{4}{13}{\textbf {How closely play follows the canonical memory-one rules, against the payoff scale.} Both panels are computed by exact matching, with no learned component. (a) Provenance of the strategy read-out, pooled over the five models; the per-model trends, which do not all have the same sign, are in table~\ref {tab:strategy}. (b) Mean number of rounds, out of the ten played, violating the nearest canonical rule}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}The effect is present before any strategic interaction}{13}{subsection.3.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Share of agent-games carrying each canonical label, against the payoff scale.} One panel per canonical rule: (a) AllC, (b) Tit-for-Tat, (c) Win-Stay-Lose-Shift, (d) AllD. Each point is the share of that model's 400 agent-games at that scale carrying the label, and shaded bands mark the two scales at which every payoff printed is at most 1. The AllC and AllD panels rest partly on exact rule matching, whereas the Tit-for-Tat and Win-Stay-Lose-Shift labels are $94.6\%$ and $97.1\%$ attributions made where no canonical rule fits, and should be read as a resemblance rather than as an identification.}}{14}{figure.caption.8}\protected@file@percent }
\newlabel{fig:mix}{{5}{14}{\textbf {Share of agent-games carrying each canonical label, against the payoff scale.} One panel per canonical rule: (a) AllC, (b) Tit-for-Tat, (c) Win-Stay-Lose-Shift, (d) AllD. Each point is the share of that model's 400 agent-games at that scale carrying the label, and shaded bands mark the two scales at which every payoff printed is at most 1. The AllC and AllD panels rest partly on exact rule matching, whereas the Tit-for-Tat and Win-Stay-Lose-Shift labels are $94.6\%$ and $97.1\%$ attributions made where no canonical rule fits, and should be read as a resemblance rather than as an identification}{figure.caption.8}{}}
