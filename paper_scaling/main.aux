\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {How closely play follows the canonical memory-one rules, against the payoff scale.} Both panels are computed by exact matching, with no learned component. (a) Provenance of the strategy read-out, pooled over the five models; the per-model trends, which do not all have the same sign, are in table~\ref {tab:strategy}. (b) Mean number of rounds, out of the ten played, violating the nearest canonical rule.}}{12}{figure.caption.7}\protected@file@percent }
\newlabel{fig:strategy}{{4}{12}{\textbf {How closely play follows the canonical memory-one rules, against the payoff scale.} Both panels are computed by exact matching, with no learned component. (a) Provenance of the strategy read-out, pooled over the five models; the per-model trends, which do not all have the same sign, are in table~\ref {tab:strategy}. (b) Mean number of rounds, out of the ten played, violating the nearest canonical rule}{figure.caption.7}{}}
