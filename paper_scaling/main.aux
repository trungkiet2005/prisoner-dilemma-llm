\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Cooperation moves under a transformation that cannot matter}{3}{subsection.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {A rescaling that cannot matter, and does.} \textbf  {(a)} The same prisoner's dilemma at three payoff scales. The agent is shown years of imprisonment and told to minimise them; multiplying every cell by $\lambda $ leaves preferences, best replies, equilibria and replicator dynamics unchanged. \textbf  {(b)} Cooperation against the payoff scale for each model, with 95\% intervals from a bootstrap that resamples whole dyads. The shaded band marks the two scales at which every payoff printed is at most 1. Each point aggregates 200 dyads. \textbf  {(c)} The same curves centred within model, with their average in black. The models disagree in shape to the point of anticorrelation, so the average swings 0.048 where the typical model swings 0.136.}}{4}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:scaling}{{1}{4}{\textbf {A rescaling that cannot matter, and does.} \textbf {(a)} The same prisoner's dilemma at three payoff scales. The agent is shown years of imprisonment and told to minimise them; multiplying every cell by $\lam $ leaves preferences, best replies, equilibria and replicator dynamics unchanged. \textbf {(b)} Cooperation against the payoff scale for each model, with 95\% intervals from a bootstrap that resamples whole dyads. The shaded band marks the two scales at which every payoff printed is at most 1. Each point aggregates 200 dyads. \textbf {(c)} The same curves centred within model, with their average in black. The models disagree in shape to the point of anticorrelation, so the average swings 0.048 where the typical model swings 0.136}{figure.caption.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Averaging across models reports the effect as almost absent}{4}{subsection.2.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.4}The prompt language sets how large the effect is}{4}{subsection.2.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Cooperation moves with the payoff scale in every model.} Minimum and maximum cooperation rate over the ten scales, their range, a 95\% confidence interval on that range from a bootstrap that resamples whole dyads, and a permutation test that shuffles the scale label within language and persona (2{,}000 draws, so $0.0005$ is the smallest attainable value). The last two columns give a Wald test on the nine scale contrasts of a per-model logistic regression of the round-level decision, with standard errors clustered on the dyad ($n=40{,}000$ decisions and $2{,}000$ clusters per model).}}{5}{table.caption.2}\protected@file@percent }
\newlabel{tab:effect}{{1}{5}{\textbf {Cooperation moves with the payoff scale in every model.} Minimum and maximum cooperation rate over the ten scales, their range, a 95\% confidence interval on that range from a bootstrap that resamples whole dyads, and a permutation test that shuffles the scale label within language and persona (2{,}000 draws, so $0.0005$ is the smallest attainable value). The last two columns give a Wald test on the nine scale contrasts of a per-model logistic regression of the round-level decision, with standard errors clustered on the dyad ($n=40{,}000$ decisions and $2{,}000$ clusters per model)}{table.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {The payoff scale gates the persona instruction.} The persona effect is the cooperation rate of an agent told it is cooperative minus that of an agent told it is selfish. It is reported separately for the two scales at which every payoff printed is at most 1 ($\lambda \leq 0.1$) and for the eight at which some payoff exceeds it. The shift between the two regimes carries a 95\% confidence interval from the dyad bootstrap; the last column records whether the persona effect changes sign.}}{5}{table.caption.3}\protected@file@percent }
\newlabel{tab:persona}{{2}{5}{\textbf {The payoff scale gates the persona instruction.} The persona effect is the cooperation rate of an agent told it is cooperative minus that of an agent told it is selfish. It is reported separately for the two scales at which every payoff printed is at most 1 ($\lam \leq 0.1$) and for the eight at which some payoff exceeds it. The shift between the two regimes carries a 95\% confidence interval from the dyad bootstrap; the last column records whether the persona effect changes sign}{table.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.5}The payoff scale gates the persona instruction}{5}{subsection.2.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Larger payoffs make play less rule-governed in three models of five.} The left block gives the share of agent-games matched exactly by one of the four canonical rules, below and above the sub-unit boundary, and the coefficient of a logistic regression of that indicator on $\log _{10}\lambda $. The right block gives the mean number of rounds that violate the nearest canonical rule at the smallest and largest scale, and the same trend fitted by least squares. Both use standard errors clustered on the dyad. Neither quantity depends on the learned classifier.}}{6}{table.caption.4}\protected@file@percent }
\newlabel{tab:strategy}{{3}{6}{\textbf {Larger payoffs make play less rule-governed in three models of five.} The left block gives the share of agent-games matched exactly by one of the four canonical rules, below and above the sub-unit boundary, and the coefficient of a logistic regression of that indicator on $\log _{10}\lam $. The right block gives the mean number of rounds that violate the nearest canonical rule at the smallest and largest scale, and the same trend fitted by least squares. Both use standard errors clustered on the dyad. Neither quantity depends on the learned classifier}{table.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {The prompt language sets how large the scale effect is.} Cooperation against the payoff scale, separately for each model and each of the five prompt languages; 40 dyads per point. The annotation in each panel gives the smallest and largest across-scale range among that model's five languages. The same model can be nearly flat in one language and swing by more than 0.4 in another.}}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:language}{{2}{6}{\textbf {The prompt language sets how large the scale effect is.} Cooperation against the payoff scale, separately for each model and each of the five prompt languages; 40 dyads per point. The annotation in each panel gives the smallest and largest across-scale range among that model's five languages. The same model can be nearly flat in one language and swing by more than 0.4 in another}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The payoff scale gates the persona instruction.} \textbf  {(a)} Persona effect, the cooperation rate under a cooperative persona minus that under a selfish one, against the payoff scale. The shaded band marks the two scales at which every payoff printed is at most 1. Three models of five cross zero at that boundary. \textbf  {(b)} The same contrast summarised: open markers give the mean persona effect at $\lambda \leq 0.1$, filled markers at $\lambda \geq 0.25$. Every model shifts in the same direction, and the shift excludes zero in all five (Table~\ref {tab:persona}).}}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:persona}{{3}{7}{\textbf {The payoff scale gates the persona instruction.} \textbf {(a)} Persona effect, the cooperation rate under a cooperative persona minus that under a selfish one, against the payoff scale. The shaded band marks the two scales at which every payoff printed is at most 1. Three models of five cross zero at that boundary. \textbf {(b)} The same contrast summarised: open markers give the mean persona effect at $\lam \leq 0.1$, filled markers at $\lam \geq 0.25$. Every model shifts in the same direction, and the shift excludes zero in all five (Table~\ref {tab:persona})}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.6}The scale changes which strategy is played}{7}{subsection.2.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Larger payoffs change what is played, not only how often it cooperates.} \textbf  {(a)} Provenance of the strategy read-out against the payoff scale, pooled over models. Exact rule matches become rarer as the payoffs grow. \textbf  {(b)} Mean number of rounds violating the nearest canonical rule. This quantity is computed by exact matching and involves no learned component.}}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:strategy}{{4}{8}{\textbf {Larger payoffs change what is played, not only how often it cooperates.} \textbf {(a)} Provenance of the strategy read-out against the payoff scale, pooled over models. Exact rule matches become rarer as the payoffs grow. \textbf {(b)} Mean number of rounds violating the nearest canonical rule. This quantity is computed by exact matching and involves no learned component}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.7}The effect is present on the opening move}{8}{subsection.2.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Which strategy is played, against the payoff scale.} One panel per canonical rule: \textbf  {(a)} AllC, \textbf  {(b)} Tit-for-Tat, \textbf  {(c)} Win-Stay-Lose-Shift, \textbf  {(d)} AllD. Each point is the share of that model's 400 agent-games at that scale carrying the label, so the four panels sum to 100\% within every model and scale and share a common vertical axis. Shaded bands mark the two scales at which every payoff printed is at most 1. The models do not move together: GPT-5.4 Nano trades AllD for AllC as the payoffs grow while Gemini 3.5 Flash-Lite moves the opposite way on AllC, and Claude Haiku 4.5 shifts from AllC towards Win-Stay-Lose-Shift. The AllC and AllD panels rest partly on exact rule matching, whereas the Tit-for-Tat and Win-Stay-Lose-Shift labels are $95.4\%$ and $97.3\%$ attributions made where no canonical rule fits, and should be read as a resemblance rather than as an identification.}}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:mix}{{5}{9}{\textbf {Which strategy is played, against the payoff scale.} One panel per canonical rule: \textbf {(a)} AllC, \textbf {(b)} Tit-for-Tat, \textbf {(c)} Win-Stay-Lose-Shift, \textbf {(d)} AllD. Each point is the share of that model's 400 agent-games at that scale carrying the label, so the four panels sum to 100\% within every model and scale and share a common vertical axis. Shaded bands mark the two scales at which every payoff printed is at most 1. The models do not move together: GPT-5.4 Nano trades AllD for AllC as the payoffs grow while Gemini 3.5 Flash-Lite moves the opposite way on AllC, and Claude Haiku 4.5 shifts from AllC towards Win-Stay-Lose-Shift. The AllC and AllD panels rest partly on exact rule matching, whereas the Tit-for-Tat and Win-Stay-Lose-Shift labels are $95.4\%$ and $97.3\%$ attributions made where no canonical rule fits, and should be read as a resemblance rather than as an identification}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Discussion}{9}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {The scale effect is present before any history exists.} \textbf  {(a)} Cooperation on the opening move against the payoff scale. At round 1 the agent has seen the matrix and the instructions and nothing else. \textbf  {(b)} Range of cooperation across the ten scales, on the opening move (solid) and over rounds 2 to 10 (hatched). In four models of five the opening move carries the larger range. Qwen3 235B-A22B is the exception: its opening move is fixed by its persona at 0.50 and cannot vary.}}{10}{figure.caption.9}\protected@file@percent }
\newlabel{fig:firstmove}{{6}{10}{\textbf {The scale effect is present before any history exists.} \textbf {(a)} Cooperation on the opening move against the payoff scale. At round 1 the agent has seen the matrix and the instructions and nothing else. \textbf {(b)} Range of cooperation across the ten scales, on the opening move (solid) and over rounds 2 to 10 (hatched). In four models of five the opening move carries the larger range. Qwen3 235B-A22B is the exception: its opening move is fixed by its persona at 0.50 and cannot vary}{figure.caption.9}{}}
