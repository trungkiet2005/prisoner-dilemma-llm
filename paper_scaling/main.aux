\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}What the rescaling does not move}{9}{subsection.3.5}\protected@file@percent }
\newlabel{sec:invariant}{{3.5}{9}{What the rescaling does not move}{subsection.3.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Where the effect enters, and what it leaves alone.} (\textbf  {a}) Cooperation by notation regime across the game. Solid lines are the open-weight arm, dashed the frontier arm; the four positions are round one and three equal blocks of the remaining rounds. The gap between the regimes is open at round one, before any history exists. (\textbf  {b}) Opening-move cooperation against the payoff scale, one line per model, colours as in figure~\ref {fig:response}. (\textbf  {c}) The largest shift across scales for six measures of the same games, against the same permutation null. Dark bars are the open-weight arm, pale the frontier arm; grey marks a measure whose shift does not clear its null. The level of cooperation moves in both arms; the rate at which the two agents fail to match does not.}}{10}{figure.caption.4}\protected@file@percent }
\newlabel{fig:where}{{4}{10}{\textbf {Where the effect enters, and what it leaves alone.} (\textbf {a}) Cooperation by notation regime across the game. Solid lines are the open-weight arm, dashed the frontier arm; the four positions are round one and three equal blocks of the remaining rounds. The gap between the regimes is open at round one, before any history exists. (\textbf {b}) Opening-move cooperation against the payoff scale, one line per model, colours as in figure~\ref {fig:response}. (\textbf {c}) The largest shift across scales for six measures of the same games, against the same permutation null. Dark bars are the open-weight arm, pale the frontier arm; grey marks a measure whose shift does not clear its null. The level of cooperation moves in both arms; the rate at which the two agents fail to match does not}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.6}The scale shifts how far the persona instruction is obeyed}{10}{subsection.3.6}\protected@file@percent }
\newlabel{sec:gating}{{3.6}{10}{The scale shifts how far the persona instruction is obeyed}{subsection.3.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {What the payoff scale carries with it.} (\textbf  {a}) The effect of being told to be cooperative rather than selfish, scale by scale, \emph  {one line per model}; colours as in figure~\ref {fig:response}, solid the open-weight arm and dashed the frontier arm. Every model moves upward across the fractional-to-unit boundary and the three open-weight models move back down into the large regime, but only two of the seven cross zero: the sign of the effect is a property of the model. The average of these lines crosses zero although almost none of them does, which is why no pooled curve is drawn. (\textbf  {b}) Cooperation by prompt language across the sweep, open-weight arm. The five languages do not move together: Arabic falls from $\lambda = 10$ onward while Vietnamese rises. (\textbf  {c}) The share of agent-games carrying each strategy label, against the payoff scale, with the arms encoded as in figure~\ref {fig:where}a. The two unconditional rules trace the cooperation curve of figure~\ref {fig:response} and its mirror image; the two conditional rules stay nearly flat.}}{11}{figure.caption.5}\protected@file@percent }
\newlabel{fig:gating}{{5}{11}{\textbf {What the payoff scale carries with it.} (\textbf {a}) The effect of being told to be cooperative rather than selfish, scale by scale, \emph {one line per model}; colours as in figure~\ref {fig:response}, solid the open-weight arm and dashed the frontier arm. Every model moves upward across the fractional-to-unit boundary and the three open-weight models move back down into the large regime, but only two of the seven cross zero: the sign of the effect is a property of the model. The average of these lines crosses zero although almost none of them does, which is why no pooled curve is drawn. (\textbf {b}) Cooperation by prompt language across the sweep, open-weight arm. The five languages do not move together: Arabic falls from $\lam = 10$ onward while Vietnamese rises. (\textbf {c}) The share of agent-games carrying each strategy label, against the payoff scale, with the arms encoded as in figure~\ref {fig:where}a. The two unconditional rules trace the cooperation curve of figure~\ref {fig:response} and its mirror image; the two conditional rules stay nearly flat}{figure.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {The persona instruction, by model and notation regime.} The effect is the cooperation rate of an agent told to be cooperative minus that of an agent told to be selfish, measured within a regime. ``Shift'' is the difference between two of those effects, with its own bootstrap over whole dyads. A dagger marks an entry whose 95\% interval excludes zero. The last column records whether the effect keeps one sign over the whole sweep. Read down the shift columns: every model moves toward compliance entering the unit regime and away from it leaving the unit regime, which is the shared pattern. Read down the effect columns: five of the seven never change sign, which is why the pooled curve of \S  \ref {sec:gating} describes no individual model. The same effects scale by scale rather than regime by regime are in the electronic supplementary material, table S4.}}{12}{table.caption.6}\protected@file@percent }
\newlabel{tab:persona}{{1}{12}{\textbf {The persona instruction, by model and notation regime.} The effect is the cooperation rate of an agent told to be cooperative minus that of an agent told to be selfish, measured within a regime. ``Shift'' is the difference between two of those effects, with its own bootstrap over whole dyads. A dagger marks an entry whose 95\% interval excludes zero. The last column records whether the effect keeps one sign over the whole sweep. Read down the shift columns: every model moves toward compliance entering the unit regime and away from it leaving the unit regime, which is the shared pattern. Read down the effect columns: five of the seven never change sign, which is why the pooled curve of \S \ref {sec:gating} describes no individual model. The same effects scale by scale rather than regime by regime are in the electronic supplementary material, table S4}{table.caption.6}{}}
