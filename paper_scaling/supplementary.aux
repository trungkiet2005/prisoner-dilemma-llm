\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces \textbf  {The corpus, by model.} Every model was run on the same ten payoff scales and five prompt languages. ``Cell $n$'' is the number of dyads in each model $\times $ language $\times $ scale cell; the design is balanced with none missing, and the build refuses to write its tables otherwise.}}{6}{table.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:S-corpus}{{S1}{6}{\textbf {The corpus, by model.} Every model was run on the same ten payoff scales and five prompt languages. ``Cell $n$'' is the number of dyads in each model $\times $ language $\times $ scale cell; the design is balanced with none missing, and the build refuses to write its tables otherwise}{table.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces \textbf  {Cooperation by model and payoff scale.} Each entry aggregates 200 dyads. The bracketed line under each model is a 95\% confidence interval from a bootstrap that resamples whole dyads.}}{6}{table.caption.3}\protected@file@percent }
\newlabel{tab:S-scale}{{S2}{6}{\textbf {Cooperation by model and payoff scale.} Each entry aggregates 200 dyads. The bracketed line under each model is a 95\% confidence interval from a bootstrap that resamples whole dyads}{table.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces \textbf  {Cooperation by model, prompt language and payoff scale.} 40 dyads per entry. The final column is the range across the ten scales for that model and language; it runs from 0.080 to 0.449, so the scale sensitivity of a model is a property of the model and the language jointly.}}{7}{table.caption.4}\protected@file@percent }
\newlabel{tab:S-language}{{S3}{7}{\textbf {Cooperation by model, prompt language and payoff scale.} 40 dyads per entry. The final column is the range across the ten scales for that model and language; it runs from 0.080 to 0.449, so the scale sensitivity of a model is a property of the model and the language jointly}{table.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces \textbf  {Variance decomposition of the cell means.} Type-II analysis of variance on the 250 model $\times $ language $\times $ scale cell means, where the design is exactly balanced. The payoff scale has no significant main effect while both of its interactions are significant.}}{7}{table.caption.5}\protected@file@percent }
\newlabel{tab:S-variance}{{S4}{7}{\textbf {Variance decomposition of the cell means.} Type-II analysis of variance on the 250 model $\times $ language $\times $ scale cell means, where the design is exactly balanced. The payoff scale has no significant main effect while both of its interactions are significant}{table.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces \textbf  {Persona effect by model and payoff scale.} The cooperation rate of an agent instructed that it is cooperative minus that of an agent instructed that it is selfish, at each scale. The two leftmost columns are the scales at which every payoff printed is at most 1.}}{8}{table.caption.6}\protected@file@percent }
\newlabel{tab:S-persona}{{S5}{8}{\textbf {Persona effect by model and payoff scale.} The cooperation rate of an agent instructed that it is cooperative minus that of an agent instructed that it is selfish, at each scale. The two leftmost columns are the scales at which every payoff printed is at most 1}{table.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S6}{\ignorespaces \textbf  {Share of agent-games matched exactly by one canonical rule (\%).} Computed by exact rule matching, with no learned component. 400 agent-games per entry.}}{8}{table.caption.7}\protected@file@percent }
\newlabel{tab:S-deduced}{{S6}{8}{\textbf {Share of agent-games matched exactly by one canonical rule (\%).} Computed by exact rule matching, with no learned component. 400 agent-games per entry}{table.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S7}{\ignorespaces \textbf  {Strategy composition by model and payoff scale (\%).} The label assigned by the hybrid read-out: the rule base fixes the candidate set and the LSTM ranks within it, deciding alone only where no canonical rule fits. Columns sum to 100 within each model and scale.}}{9}{table.caption.8}\protected@file@percent }
\newlabel{tab:S-mix}{{S7}{9}{\textbf {Strategy composition by model and payoff scale (\%).} The label assigned by the hybrid read-out: the rule base fixes the candidate set and the LSTM ranks within it, deciding alone only where no canonical rule fits. Columns sum to 100 within each model and scale}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S8}{\ignorespaces \textbf  {Provenance of each label.} For every label, the share of the agent-games carrying it that were deduced (exactly one canonical rule fits), ambiguous (several fit, and the LSTM ranked within that set) or unmatched (no canonical rule fits, so the label is an attribution the LSTM makes alone). The asymmetry is severe and bounds how the compositional result may be read: AllC and AllD carry a substantial deduced share, whereas the TFT and WSLS labels are almost entirely attributions.}}{9}{table.caption.9}\protected@file@percent }
\newlabel{tab:S-provenance}{{S8}{9}{\textbf {Provenance of each label.} For every label, the share of the agent-games carrying it that were deduced (exactly one canonical rule fits), ambiguous (several fit, and the LSTM ranked within that set) or unmatched (no canonical rule fits, so the label is an attribution the LSTM makes alone). The asymmetry is severe and bounds how the compositional result may be read: AllC and AllD carry a substantial deduced share, whereas the TFT and WSLS labels are almost entirely attributions}{table.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S9}{\ignorespaces \textbf  {Validation of the LSTM branch.} Trained on synthetic AllC / AllD / Tit-for-Tat / Win-Stay-Lose-Shift trajectories at zero and 5\% execution noise, balanced at 40{,}320 sequences per strategy per level. The 10\% and 20\% noise levels are never trained on. No language-model transcript enters training.}}{10}{table.caption.10}\protected@file@percent }
\newlabel{tab:S-classifier}{{S9}{10}{\textbf {Validation of the LSTM branch.} Trained on synthetic AllC / AllD / Tit-for-Tat / Win-Stay-Lose-Shift trajectories at zero and 5\% execution noise, balanced at 40{,}320 sequences per strategy per level. The 10\% and 20\% noise levels are never trained on. No language-model transcript enters training}{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S10}{\ignorespaces \textbf  {Pairwise correlation between the model curves.} Correlation of the ten-point cooperation-against-scale curves of each pair of models. Six of the ten pairs are negative and the mean is $-0.10$, which is why averaging the curves cancels most of the movement.}}{10}{table.caption.11}\protected@file@percent }
\newlabel{tab:S-shapes}{{S10}{10}{\textbf {Pairwise correlation between the model curves.} Correlation of the ten-point cooperation-against-scale curves of each pair of models. Six of the ten pairs are negative and the mean is $-0.10$, which is why averaging the curves cancels most of the movement}{table.caption.11}{}}
